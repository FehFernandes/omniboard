# ═══════════════════════════════════════════
# OmniBoard API — environment variables
# ═══════════════════════════════════════════

# Server
PORT=4000
ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=omniboard_dev
# Use require/verify-full in production, disable in dev. Automatic default:
# require when in production.
DB_SSLMODE=disable

# Connection pool (per instance). Keep the sum below Postgres' max_connections.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

# Migration strategy:
#   (empty)    → AutoMigrate (GORM) on startup — convenient in dev.
#   versioned  → embedded versioned migrations (golang-migrate). Recommended in
#                production. Run with `make migrate-up`, or let the app apply
#                them on startup when DB_MIGRATE=versioned.
DB_MIGRATE=

# JWT — REQUIRED. Generate with: openssl rand -base64 32
# In production use distinct secrets of at least 32 characters.
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30

# CORS (allowed origins, comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Frontend base URL — used in email links (reset, verification).
APP_URL=http://localhost:5173

# Email (mailer). CURRENTLY UNUSED: emails existed for account verification and
# password reset, flows that disappeared with Google-only login. The
# internal/mailer package stays in the repository for future use (notifications),
# but nothing calls it today — filling these variables has no effect.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# Redis (optional) — distributed store for the rate limiter.
# Recommended in production with multiple instances. When empty, counters are
# kept in memory per instance.
# e.g. redis://default:password@localhost:6379/0
REDIS_URL=

# Maintenance job: interval (minutes) for purging expired sessions and
# verification_tokens. Default 60. One pass also runs on startup.
PURGE_INTERVAL_MINUTES=60

# Orphan image sweep: interval (hours) for deleting bucket objects no board
# references anymore. Default 24. Disabled automatically without an R2 bucket.
ORPHAN_SWEEP_HOURS=24

# Metrics: /metrics (Prometheus). Open in dev/test. In production it is
# fail-closed: set a token to allow scraping with Authorization: Bearer <token>;
# without a token, /metrics is unavailable (404) in production.
METRICS_TOKEN=

# 2FA (TOTP): issuer name shown in the authenticator app (Google Authenticator…).
TOTP_ISSUER=OmniBoard

# ── Google login (REQUIRED) ──
# It is the ONLY way to authenticate in the app: there is no sign-up and no
# password login. Without these two variables the server DOES NOT START.
#
# NOTE: these credentials do NOT come from the `gcloud` CLI installed on your
# machine. Signing in to gcloud authenticates YOU against Google APIs; to
# authenticate the app's USERS you need your own OAuth Client. No gcloud command
# creates this kind of client (`gcloud iam oauth-clients` belongs to Workforce
# Identity Federation, a different thing) — it has to be done in the Console:
#
#   1. Console → select/create the project:
#        https://console.cloud.google.com/projectselector2/apis/credentials
#   2. "OAuth consent screen" (Google Auth Platform): User type = External, fill
#      in the app name and support email. While in Testing, add your Gmail under
#      "Test users" (without it even the owner is blocked).
#   3. Credentials → Create credentials → OAuth client ID
#        Application type: Web application
#        Authorized redirect URIs: http://localhost:4000/api/auth/google/callback
#      (it must match GOOGLE_REDIRECT_URL below BYTE FOR BYTE; in production,
#       also register the API's public URL)
#   4. Copy the Client ID and Client secret into the variables below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be identical to one of the OAuth client's "Authorized redirect URIs".
# When empty, the default is API_URL + /api/auth/google/callback.
GOOGLE_REDIRECT_URL=http://localhost:4000/api/auth/google/callback

# ── Billing / payments (subscription) ──
# Without STRIPE_SECRET_KEY the app uses the FAKE provider: testable locally, no
# key needed. Its checkout returns a link to /api/billing/dev/complete that
# activates the subscription right away (dev only). Fill in the keys below to use
# real Stripe (use the TEST keys: sk_test_... / whsec_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID (price_...) created in the Stripe dashboard, for the paid plan.
STRIPE_PRICE_PRO=
# This API's public URL — used by the FAKE provider to build the checkout
# completion link in dev. In production, point it at the API's real URL.
API_URL=http://localhost:4000

# ── Image uploads (Cloudflare R2, or any S3-compatible bucket) ──
# Without these variables uploads are DISABLED and the board embeds the image in
# the snapshot (it works, but the binary travels on every save and blows past the
# BodyLimit).
#
# In the Cloudflare dashboard:
#   1. R2 → Create bucket (e.g. omniboard). Region: automatic.
#   2. R2 → Manage API tokens → Create API token
#        Permission: Object Read & Write, scoped to this bucket only.
#        Copy Access Key ID / Secret Access Key (the secret is shown once).
#      The Account ID is in the R2 dashboard (used to build the endpoint).
#   3. Public read: bucket → Settings → Public access.
#        Option A: custom domain (recommended) → R2_PUBLIC_BASE_URL=https://cdn.yourdomain.com
#        Option B: development r2.dev → R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
#      Object keys are random (unguessable), but anyone with the URL can read the
#      file — that is the trade for a stable URL inside the board.
#   4. Bucket CORS (the browser PUTs directly): Settings → CORS policy
#        AllowedOrigins: the app URL (e.g. http://localhost:5173 and production)
#        AllowedMethods: PUT
#        AllowedHeaders: content-type
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
# Optional: overrides the endpoint derived from R2_ACCOUNT_ID (another S3 provider).
R2_ENDPOINT=
# Per-file cap (bytes) and signed URL lifetime (seconds).
R2_MAX_UPLOAD_BYTES=10485760
R2_PRESIGN_EXPIRES_SECONDS=300
