# Shared configuration across editors. Avoids whitespace diffs when someone
# contributes from a different editor.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
# gofmt uses tabs. Not a preference: it is the language standard and CI enforces it.
indent_style = tab

[Makefile]
indent_style = tab

[*.md]
# A trailing space is a line break in Markdown.
trim_trailing_whitespace = false
